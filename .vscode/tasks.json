{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: Build current file (LuaLaTeX + bibliography)",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "${fileBasename}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LaTeX: Build current file (LuaLaTeX -> BibTeX -> LuaLaTeX x2)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "lualatex -synctex=1 -interaction=nonstopmode -file-line-error '${fileBasename}'; bibtex '${fileBasenameNoExtension}'; lualatex -synctex=1 -interaction=nonstopmode -file-line-error '${fileBasename}'; lualatex -synctex=1 -interaction=nonstopmode -file-line-error '${fileBasename}'"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": []
    }
  ]
}
