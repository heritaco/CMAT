# --- FIGURE & TEXT --------------------------------------------------
figure.figsize        : 12, 8   #
figure.dpi            : 100
savefig.format        : png        # vector by default
font.family           : Times New Roman
# font.serif            : Palatino
font.size             : 12         # Body text size
axes.titlesize        : 16
axes.labelsize        : 12
legend.fontsize       : 11
xtick.labelsize       : 10
ytick.labelsize       : 10
text.usetex           : False      # keep pure matplotlib

# --- LINES & MARKERS -----------------------------------------------
lines.linewidth       : 1
lines.markersize      : 4
axes.prop_cycle : cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2', '7f7f7f', 'bcbd22', '17becf'])

# --- GRID & LAYOUT --------------------------------------------------
axes.grid             : True
grid.alpha            : 0.5
grid.linestyle        : -
axes.grid.which       : major
axes.xmargin          : 0.01
axes.ymargin          : 0.05

ytick.minor.visible : False
ytick.minor.size : 1
ytick.minor.width : 1
ytick.major.size : 3.5
ytick.major.width : 1.25
ytick.left : true
ytick.right : true
ytick.direction : inout
xtick.minor.visible : True
xtick.minor.size : 1
xtick.minor.width : 1
xtick.major.size : 5
xtick.major.width : 1.25
xtick.bottom : true
xtick.direction : inout

# figure.constrained_layout.use : True
